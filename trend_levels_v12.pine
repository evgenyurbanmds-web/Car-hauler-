//@version=5
// ============================================================
// ТРЕНД + УРОВНИ: всё в одном индикаторе
// v12 (2026-11-16): шаг круглых уровней — автоматический под
// масштаб цены: 5 * 10^(порядок цены - 1) — BTC 5000 (как
// раньше), ETH 500, SOL 5, акции 50. Круглый уровень дальше
// 20% от цены не рисуется. В v11 шаг был жёстко 5000, и на
// любом символе дешевле $5000 линия $5000 растягивала шкалу
// графика, а стрелка тренда уезжала к $5000. В настройках
// шаг по-прежнему можно задать вручную (0 = авто).
// v11 (2026-11-16): (1) сильное движение признаётся трендом и без
// креста EMA50/200 — при ADX >= 30 и спреде DI >= 20 направление
// берётся по цене против EMA50 и по DI (в v10 после резкого
// падения дневка неделями показывала «флэт»); (2) убран потолок
// 9 у счётчика касаний уровней — теперь число касаний точное
// (на силу уровня это не влияет: там касания и так режутся до 5).
// ------------------------------------------------------------
// Что внутри (1 индикатор вместо 2 на бесплатном тарифе):
//   1. EMA20 (жёлтая), EMA50 (оранжевая), EMA200 (красная) —
//      те же цвета, что у тебя на телефоне.
//   2. ADX(14) + DI — в таблице справа вверху, вместе с
//      состоянием тренда. Отдельный индикатор ADX больше не
//      обязателен, но можешь оставить и его — слот свободен.
//   3. Авто-уровни разворота: пивоты (swing high/low) за
//      всю историю графика группируются в кластеры (±0.8%),
//      ближайшие 3 сопротивления сверху и 3 поддержки снизу
//      рисуются линиями с числом касаний и СИЛОЙ уровня:
//      "R $74,849 (2) 6/10". Сила = касания (до 5) + объём
//      на касаниях + сила отскока (тень/ATR) + слияние с EMA
//      или круглым числом + свежесть касания. Плюс круглые
//      уровни ($70,000, $65,000...) — пунктиром.
//   4. Фон: зелёный — тренд вверх, красный — вниз.
//   5. Стрелка тренда НАД самым верхним уровнем (чтобы не
//      налезала на подписи уровней): зелёная ▲ вверх,
//      красная ▼ вниз, серая ◆ во флэте + сила тренда 0–10
//      (ADX + сонаправленность EMA + спред DI). Уровни
//      подписаны с числом касаний: "R $65,065 · 2 касания · 6/10".
//   6. Профиль объёма за последние N свечей (по умолчанию
//      200): POC — цена с максимальным объёмом, VAH/VAL —
//      границы зоны стоимости (70% объёма вокруг POC).
//      POC — оранжевая жирная линия, VAH/VAL — пунктир.
//      Значения POC/VAH/VAL — в панели справа.
//   7. Магнит 🧲 и тяга: по обе стороны цены берётся ближайший
//      СИЛЬНЫЙ уровень (4+/10), а если сильного нет — ближайший
//      вообще. Тяга стороны = сила уровня × фактор импульса
//      (доминирующий DI усиливает свою сторону) / (1 + расстояние
//      в %). В панели строка "Тяга" показывает оба уровня и
//      процент тяги к каждому; магнит — тот, чья тяга больше.
//      Магнит помечается 🧲 в подписи и жирной линией.
// Как поставить: TradingView в БРАУЗЕРЕ (на компьютере или
// на телефоне в режиме "версия для ПК") → внизу "Pine Editor"
// → вставить этот код → "Add to chart". В приложении на
// телефоне Pine Editor нет, но график синхронизируется:
// добавил на компьютере — появился и в приложении.
// Лучше всего работает на дневном графике, также на 4ч.
// ============================================================
indicator("Тренд + Уровни v12 [EMA/ADX/SR]", shorttitle="Тренд+Уровни v12",
     overlay=true, max_lines_count=500, max_labels_count=500)

// ---------- Настройки ----------
grpEma = "EMA"
ema20Len  = input.int(20, "EMA быстрая", minval=2, group=grpEma)
ema50Len  = input.int(50, "EMA средняя", minval=2, group=grpEma)
ema200Len = input.int(200, "EMA медленная", minval=2, group=grpEma)

grpAdx = "ADX"
adxLen = input.int(14, "ADX длина", minval=2, group=grpAdx)

grpLv = "Уровни разворота"
pivLen    = input.int(5, "Пивот: свечей с каждой стороны", minval=2, maxval=20, group=grpLv)
tolPct    = input.float(0.8, "Кластер уровней, %", minval=0.1, step=0.1, group=grpLv) / 100
showRound = input.bool(true, "Круглые уровни", group=grpLv)
roundStep = input.int(0, "Шаг круглых уровней (0 = авто)", minval=0, step=100, group=grpLv)
// Авто-шаг под масштаб цены: 5 * 10^(порядок цены - 1).
// BTC ~64 000 -> 5000 (как раньше), ETH ~1 800 -> 500,
// SOL ~70 -> 5, акции ~350 -> 50, индекс ~100 -> 50.
autoStep = 5 * math.pow(10, math.floor(math.log10(close)) - 1)
effStep = roundStep > 0 ? float(roundStep) : autoStep

grpView = "Отображение"
showBg   = input.bool(true, "Фон тренда", group=grpView)
showDash = input.bool(true, "Панель состояния", group=grpView)

grpVP = "Профиль объёма"
vpOn    = input.bool(true, "Показывать POC / VAH / VAL", group=grpVP)
vpLen   = input.int(200, "Свечей в профиле", minval=20, maxval=1000, group=grpVP)
vpBins  = input.int(24, "Корзин по цене", minval=10, maxval=50, group=grpVP)
vpVaPct = input.float(70, "Зона стоимости, %", minval=50, maxval=90, group=grpVP)

grpAlert = "Алерты"
alertMinScore = input.int(8, "Сильный тренд: мин. оценка (0–10)", minval=2, maxval=10, group=grpAlert)

// ---------- EMA и ADX ----------
ema20  = ta.ema(close, ema20Len)
ema50  = ta.ema(close, ema50Len)
ema200 = ta.ema(close, ema200Len)
[plusDI, minusDI, adx] = ta.dmi(adxLen, adxLen)
atrVal = ta.atr(14)
volAvg50 = ta.sma(volume, 50)

// v11: сильное движение признаётся трендом и без креста EMA50/200,
// если ADX >= 30, спред DI >= 20 и DI подтверждает сторону цены
// относительно EMA50. Иначе после резкого движения индикатор
// неделями показывал «флэт», пока EMA200 не развернётся.
float diSpreadNow = math.abs(plusDI - minusDI)
bool strongUp   = close > ema50 and plusDI > minusDI and adx >= 30 and diSpreadNow >= 20
bool strongDown = close < ema50 and minusDI > plusDI and adx >= 30 and diSpreadNow >= 20

uptrend   = (close > ema50 and ema50 > ema200) or strongUp
downtrend = (close < ema50 and ema50 < ema200) or strongDown

plot(ema20, "EMA20", color=color.new(color.yellow, 0), linewidth=2)
plot(ema50, "EMA50", color=color.new(color.orange, 0), linewidth=2)
plot(ema200, "EMA200", color=color.new(color.red, 0), linewidth=2)

bgcolor(showBg ? (uptrend ? color.new(color.green, 90) : downtrend ? color.new(color.red, 92) : na) : na, title="Фон тренда")

// ---------- Сила тренда 0–10 ----------
// ADX (0–4) + сонаправленность EMA (0–3) + спред DI (0–2) +
// удаление цены от EMA50 (0–1). Во флэте сила не выше 3.
int adxPts = 0
if adx >= 40
    adxPts := 4
else if adx >= 30
    adxPts := 3
else if adx >= 25
    adxPts := 2
else if adx >= 20
    adxPts := 1
int emaPts = 0
if uptrend or downtrend
    emaPts := 3
else if (close > ema50) != (ema50 > ema200)
    emaPts := 1
float diSpread = math.abs(plusDI - minusDI)
int diPts = diSpread >= 20 ? 2 : diSpread >= 10 ? 1 : 0
int distPts = math.abs(close - ema50) / ema50 >= 0.05 ? 1 : 0
int trendScore = adxPts + emaPts + diPts + distPts
if not (uptrend or downtrend)
    trendScore := math.min(trendScore, 3)
string trendWord = trendScore >= 8 ? "очень сильный" : trendScore >= 6 ? "сильный" : trendScore >= 4 ? "средний" : trendScore >= 2 ? "слабый" : "нет тренда"

// ---------- Пивоты и кластеры уровней ----------
// Храним цены пивотов, число касаний, сумму относительного
// объёма и тени (в ATR) на касаниях, и бар последнего касания.
// Пивот подтверждается с задержкой pivLen свечей — это нормально:
// уровень появляется, когда разворот уже случился.
var float[] pivPrices = array.new_float()
var int[]   pivCounts = array.new_int()
var float[] pivVol = array.new_float()
var float[] pivWick = array.new_float()
var int[]   pivLast = array.new_int()
maxPiv = 120

addPivot(price, volRel, wickRel) =>
    idx = -1
    // Пустой массив: цикл for в Pine выполняется минимум раз,
    // поэтому проверяем размер заранее (иначе array.get падает).
    if array.size(pivPrices) > 0
        for i = 0 to array.size(pivPrices) - 1
            if idx == -1 and math.abs(price - array.get(pivPrices, i)) / array.get(pivPrices, i) < tolPct
                idx := i
    if idx >= 0
        old = array.get(pivPrices, idx)
        c = array.get(pivCounts, idx)
        array.set(pivPrices, idx, (old * c + price) / (c + 1))
        array.set(pivCounts, idx, c + 1)  // v11: без потолка 9, счёт точный
        array.set(pivVol, idx, array.get(pivVol, idx) + volRel)
        array.set(pivWick, idx, array.get(pivWick, idx) + wickRel)
        array.set(pivLast, idx, bar_index)
        idx
    else
        array.push(pivPrices, price)
        array.push(pivCounts, 1)
        array.push(pivVol, volRel)
        array.push(pivWick, wickRel)
        array.push(pivLast, bar_index)
        if array.size(pivPrices) > maxPiv
            array.shift(pivPrices)
            array.shift(pivCounts)
            array.shift(pivVol)
            array.shift(pivWick)
            array.shift(pivLast)
        idx

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if not na(ph)
    // Пивот сформировался pivLen свечей назад — берём его свечу.
    wickUp = (high[pivLen] - math.max(open[pivLen], close[pivLen])) / atrVal[pivLen]
    addPivot(ph, volume[pivLen] / volAvg50[pivLen], wickUp)
if not na(pl)
    wickDn = (math.min(open[pivLen], close[pivLen]) - low[pivLen]) / atrVal[pivLen]
    addPivot(pl, volume[pivLen] / volAvg50[pivLen], wickDn)

// Сила уровня 0–10: касания (до 5) + объём на касаниях выше
// среднего + резкий отскок (длинная тень) + слияние с EMA50/200
// или круглым числом + свежее касание (последние 50 свечей).
levelScore(ct, volSum, wickSum, lastBar, pr) =>
    int sc = math.min(ct, 5)
    float vAvg = volSum / ct
    float wAvg = wickSum / ct
    if vAvg > 1.2
        sc := sc + 1
    if wAvg > 0.3
        sc := sc + 1
    if math.min(math.abs(pr - ema50), math.abs(pr - ema200)) / pr < 0.01
        sc := sc + 1
    if math.abs(pr / effStep - math.round(pr / effStep)) * effStep / pr < 0.005
        sc := sc + 1
    if bar_index - lastBar <= 50
        sc := sc + 1
    math.min(sc, 10)

// Ближайшие 3 уровня в заданную сторону (above=true — сопротивления).
// Возвращает [цена1, касания1, сила1, цена2, касания2, сила2,
// цена3, касания3, сила3]. Если уровня нет — цена 1e12 (вверх) или 0 (вниз).
// Сила считается ТОЛЬКО для итоговых 3 уровней после цикла,
// а не для каждого кластера внутри — иначе поиск на каждой
// свече истории слишком медленный (тайм-аут выполнения).
nearest3(above) =>
    float p1 = above ? 1e12 : 0.0
    float p2 = above ? 1e12 : 0.0
    float p3 = above ? 1e12 : 0.0
    int c1 = 0
    int c2 = 0
    int c3 = 0
    float v1 = 0.0
    float v2 = 0.0
    float v3 = 0.0
    float w1 = 0.0
    float w2 = 0.0
    float w3 = 0.0
    int l1 = 0
    int l2 = 0
    int l3 = 0
    // while вместо for: на пустом массиве (первая свеча)
    // for выполняется раз и падает на array.get, а while
    // проверяет условие заранее и просто не входит в цикл.
    int i = 0
    while i < array.size(pivPrices)
        float pr = array.get(pivPrices, i)
        int ct = array.get(pivCounts, i)
        bool ok = above ? pr > close * 1.001 : pr < close * 0.999
        if ok
            float vv = array.get(pivVol, i)
            float ww = array.get(pivWick, i)
            int ll = array.get(pivLast, i)
            if above ? pr < p1 : pr > p1
                p3 := p2
                c3 := c2
                v3 := v2
                w3 := w2
                l3 := l2
                p2 := p1
                c2 := c1
                v2 := v1
                w2 := w1
                l2 := l1
                p1 := pr
                c1 := ct
                v1 := vv
                w1 := ww
                l1 := ll
            else if above ? pr < p2 : pr > p2
                p3 := p2
                c3 := c2
                v3 := v2
                w3 := w2
                l3 := l2
                p2 := pr
                c2 := ct
                v2 := vv
                w2 := ww
                l2 := ll
            else if above ? pr < p3 : pr > p3
                p3 := pr
                c3 := ct
                v3 := vv
                w3 := ww
                l3 := ll
        i += 1
    int s1 = p1 < 1e11 and p1 > 0 ? levelScore(c1, v1, w1, l1, p1) : 0
    int s2 = p2 < 1e11 and p2 > 0 ? levelScore(c2, v2, w2, l2, p2) : 0
    int s3 = p3 < 1e11 and p3 > 0 ? levelScore(c3, v3, w3, l3, p3) : 0
    [p1, c1, s1, p2, c2, s2, p3, c3, s3]

// Поиск уровней — на каждой свече, как было изначально:
// версия "только на последнем баре" уровни не отдавала
// (в панели было пусто). Теперь цикл дешёвый, тайм-аута нет.
[r1, rc1, rs1, r2, rc2, rs2, r3, rc3, rs3] = nearest3(true)
[s1, sc1, ss1, s2, sc2, ss2, s3, sc3, ss3] = nearest3(false)

// Круглые уровни: ближайший круглый сверху и снизу, шаг —
// эффективный (авто или ручной из настроек). Уровень дальше
// 20% от цены отбрасываем: он растягивает шкалу графика и
// утаскивает стрелку тренда далеко от цены (дефект v11 на
// символах дешевле $5000).
roundUpRaw = math.ceil(close * 1.001 / effStep) * effStep
roundDnRaw = math.floor(close * 0.999 / effStep) * effStep
roundUp = roundUpRaw / close - 1 <= 0.20 ? roundUpRaw : na
roundDn = 1 - roundDnRaw / close <= 0.20 ? roundDnRaw : na

// ---------- Магнит и тяга: куда тянет цену ----------
// По обе стороны цены берём кандидата: ближайший уровень с силой
// >= 4/10, а если сильного нет — ближайший вообще. Тяга стороны =
// сила уровня × фактор импульса / (1 + расстояние до уровня в %).
// Фактор импульса: доминирующий DI усиливает свою сторону —
// спред DI 40 и выше даёт ×2. Магнит — сторона с большей тягой;
// проценты тяги по обе стороны — в строке "Тяга" панели.
float upMag = na
int upMagScore = 0
if r1 < 1e11 and rs1 >= 4
    upMag := r1
    upMagScore := rs1
else if r2 < 1e11 and rs2 >= 4
    upMag := r2
    upMagScore := rs2
else if r3 < 1e11 and rs3 >= 4
    upMag := r3
    upMagScore := rs3
else if r1 < 1e11
    upMag := r1
    upMagScore := rs1
float dnMag = na
int dnMagScore = 0
if s1 > 0 and ss1 >= 4
    dnMag := s1
    dnMagScore := ss1
else if s2 > 0 and ss2 >= 4
    dnMag := s2
    dnMagScore := ss2
else if s3 > 0 and ss3 >= 4
    dnMag := s3
    dnMagScore := ss3
else if s1 > 0
    dnMag := s1
    dnMagScore := ss1
float diSpreadSigned = plusDI - minusDI
float upMom = diSpreadSigned >= 5 ? 1 + math.min(diSpreadSigned, 40) / 40 : 1.0
float dnMom = diSpreadSigned <= -5 ? 1 + math.min(-diSpreadSigned, 40) / 40 : 1.0
float upPull = not na(upMag) ? upMagScore * upMom / (1 + math.abs(upMag - close) / close * 100) : 0.0
float dnPull = not na(dnMag) ? dnMagScore * dnMom / (1 + math.abs(dnMag - close) / close * 100) : 0.0
float pullTot = upPull + dnPull
int upPct = pullTot > 0 ? int(math.round(upPull / pullTot * 100)) : 0
int dnPct = pullTot > 0 ? 100 - upPct : 0
float magPrice = na
int magScore = 0
string magDir = "◆"
if pullTot > 0
    if dnPull >= upPull
        magPrice := dnMag
        magScore := dnMagScore
        magDir := "▼"
    else
        magPrice := upMag
        magScore := upMagScore
        magDir := "▲"

bool magIsR1 = not na(magPrice) and r1 == magPrice
bool magIsR2 = not na(magPrice) and r2 == magPrice
bool magIsR3 = not na(magPrice) and r3 == magPrice
bool magIsS1 = not na(magPrice) and s1 == magPrice
bool magIsS2 = not na(magPrice) and s2 == magPrice
bool magIsS3 = not na(magPrice) and s3 == magPrice

// Стрелка тренда — над самым верхним уровнем: рядом с ценой,
// но выше всех подписей уровней, поэтому не налезает ни на POC,
// ни на поддержки. VAH/VAL в расчёт не берём: они далеко от цены
// и утащили бы стрелку на край графика.
float topLvl = high
if r3 < 1e11
    topLvl := math.max(topLvl, r3)
if showRound and not na(roundUp)
    topLvl := math.max(topLvl, roundUp)
float arrowY = topLvl + atrVal * 0.3

// ---------- Профиль объёма (POC / VAH / VAL) ----------
// Считается только на последнем баре: берём последние vpLen
// свечей, делим их диапазон цен на vpBins корзин, объём каждой
// свечи относим в корзину её типичной цены (hlc3). POC —
// корзина с максимальным объёмом. Зона стоимости — расширяемся
// от POC вверх/вниз (туда, где объём больше), пока не наберём
// vpVaPct% всего объёма.
var float[] vpVols = array.new_float(50, 0.0)
var float vpPOC = na
var float vpVAH = na
var float vpVAL = na
if vpOn and barstate.islast
    float vpHi = high
    float vpLo = low
    for i = 1 to vpLen - 1
        if i < bar_index
            vpHi := math.max(vpHi, high[i])
            vpLo := math.min(vpLo, low[i])
    float vpStep = (vpHi - vpLo) / vpBins
    if vpStep > 0
        for b = 0 to vpBins - 1
            array.set(vpVols, b, 0.0)
        float totVol = 0.0
        for i = 0 to vpLen - 1
            if i < bar_index
                float tp = hlc3[i]
                int b = int(math.floor((tp - vpLo) / vpStep))
                b := math.max(0, math.min(vpBins - 1, b))
                array.set(vpVols, b, array.get(vpVols, b) + nz(volume[i]))
                totVol := totVol + nz(volume[i])
        if totVol > 0
            int pocBin = 0
            float maxV = -1.0
            for b = 0 to vpBins - 1
                float v = array.get(vpVols, b)
                if v > maxV
                    maxV := v
                    pocBin := b
            vpPOC := vpLo + (pocBin + 0.5) * vpStep
            float vaVol = maxV
            int up = pocBin + 1
            int dn = pocBin - 1
            while vaVol < totVol * vpVaPct / 100 and (up < vpBins or dn >= 0)
                float vUp = up < vpBins ? array.get(vpVols, up) : -1.0
                float vDn = dn >= 0 ? array.get(vpVols, dn) : -1.0
                if vUp >= vDn and up < vpBins
                    vaVol += vUp
                    up += 1
                else if dn >= 0
                    vaVol += vDn
                    dn -= 1
                else
                    break
            vpVAH := vpLo + up * vpStep
            vpVAL := vpLo + (dn + 1) * vpStep

// ---------- Линии и подписи (создаются один раз, потом двигаются) ----------
var line lnR1 = line.new(na, na, na, na, color=color.new(#ef5350, 0), width=1, extend=extend.right)
var line lnR2 = line.new(na, na, na, na, color=color.new(#ef5350, 0), width=1, extend=extend.right)
var line lnR3 = line.new(na, na, na, na, color=color.new(#ef5350, 0), width=1, extend=extend.right)
var line lnS1 = line.new(na, na, na, na, color=color.new(#26a69a, 0), width=1, extend=extend.right)
var line lnS2 = line.new(na, na, na, na, color=color.new(#26a69a, 0), width=1, extend=extend.right)
var line lnS3 = line.new(na, na, na, na, color=color.new(#26a69a, 0), width=1, extend=extend.right)
var line lnRU = line.new(na, na, na, na, color=color.new(color.gray, 0), width=1, style=line.style_dashed, extend=extend.right)
var line lnRD = line.new(na, na, na, na, color=color.new(color.gray, 0), width=1, style=line.style_dashed, extend=extend.right)

var label lbR1 = label.new(na, na, "", style=label.style_label_left, color=color.new(#ef5350, 0), textcolor=color.white, size=size.small)
var label lbR2 = label.new(na, na, "", style=label.style_label_left, color=color.new(#ef5350, 0), textcolor=color.white, size=size.small)
var label lbR3 = label.new(na, na, "", style=label.style_label_left, color=color.new(#ef5350, 0), textcolor=color.white, size=size.small)
var label lbS1 = label.new(na, na, "", style=label.style_label_left, color=color.new(#26a69a, 0), textcolor=color.white, size=size.small)
var label lbS2 = label.new(na, na, "", style=label.style_label_left, color=color.new(#26a69a, 0), textcolor=color.white, size=size.small)
var label lbS3 = label.new(na, na, "", style=label.style_label_left, color=color.new(#26a69a, 0), textcolor=color.white, size=size.small)
var label lbRU = label.new(na, na, "", style=label.style_label_left, color=color.new(color.gray, 0), textcolor=color.white, size=size.small)
var label lbRD = label.new(na, na, "", style=label.style_label_left, color=color.new(color.gray, 0), textcolor=color.white, size=size.small)

var line lnPOC = line.new(na, na, na, na, color=color.new(#ff9800, 0), width=2, extend=extend.right)
var line lnVAH = line.new(na, na, na, na, color=color.new(#ff9800, 0), width=1, style=line.style_dashed, extend=extend.right)
var line lnVAL = line.new(na, na, na, na, color=color.new(#ff9800, 0), width=1, style=line.style_dashed, extend=extend.right)
var label lbPOC = label.new(na, na, "", style=label.style_label_left, color=color.new(#ff9800, 0), textcolor=color.white, size=size.small)
var label lbVAH = label.new(na, na, "", style=label.style_label_left, color=color.new(#ff9800, 0), textcolor=color.white, size=size.small)
var label lbVAL = label.new(na, na, "", style=label.style_label_left, color=color.new(#ff9800, 0), textcolor=color.white, size=size.small)
var label lbTrendArrow = label.new(na, na, "", style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.white, size=size.normal)

// "1 касание", "2 касания", "5 касаний".
touchWord(n) => n == 1 ? "касание" : n < 5 ? "касания" : "касаний"

setLevel(ln, lb, price, cnt, score, isRes, isMag) =>
    if price < 1e11 and price > 0
        line.set_xy1(ln, bar_index - 1, price)
        line.set_xy2(ln, bar_index, price)
        line.set_color(ln, isRes ? color.new(#ef5350, 0) : color.new(#26a69a, 0))
        line.set_width(ln, isMag ? 2 : 1)
        label.set_xy(lb, bar_index, price)
        // Уровни разворота — с числом касаний; круглые — коротко.
        // Магнит помечается 🧲.
        string txt = (isMag ? "🧲 " : "") + (cnt > 0 ? (isRes ? "R $" : "S $") + str.tostring(price, "#,###") + " · " + str.tostring(cnt) + " " + touchWord(cnt) + " · " + str.tostring(score) + "/10" : "$" + str.tostring(price, "#,###"))
        label.set_text(lb, txt)
        label.set_color(lb, isRes ? color.new(#ef5350, 0) : color.new(#26a69a, 0))
    else
        line.set_color(ln, color.new(color.gray, 100))
        label.set_text(lb, "")

if barstate.islast
    setLevel(lnR1, lbR1, r1, rc1, rs1, true, magIsR1)
    setLevel(lnR2, lbR2, r2, rc2, rs2, true, magIsR2)
    setLevel(lnR3, lbR3, r3, rc3, rs3, true, magIsR3)
    setLevel(lnS1, lbS1, s1, sc1, ss1, false, magIsS1)
    setLevel(lnS2, lbS2, s2, sc2, ss2, false, magIsS2)
    setLevel(lnS3, lbS3, s3, sc3, ss3, false, magIsS3)
    if showRound
        // Круглый уровень не рисуем, если он почти совпадает
        // с пивот-уровнем — иначе подписи накладываются.
        bool ruNear = not na(roundUp) and ((r1 < 1e11 and math.abs(roundUp - r1) / r1 < 0.005) or (r2 < 1e11 and math.abs(roundUp - r2) / r2 < 0.005) or (r3 < 1e11 and math.abs(roundUp - r3) / r3 < 0.005))
        bool rdNear = not na(roundDn) and ((s1 > 0 and math.abs(roundDn - s1) / s1 < 0.005) or (s2 > 0 and math.abs(roundDn - s2) / s2 < 0.005) or (s3 > 0 and math.abs(roundDn - s3) / s3 < 0.005))
        if not ruNear
            setLevel(lnRU, lbRU, roundUp, 0, 0, true, false)
            line.set_color(lnRU, color.new(color.gray, 0))
            label.set_color(lbRU, color.new(color.gray, 0))
            label.set_text(lbRU, "$" + str.tostring(roundUp, "#,###"))
        else
            line.set_color(lnRU, color.new(color.gray, 100))
            label.set_text(lbRU, "")
        if not rdNear
            setLevel(lnRD, lbRD, roundDn, 0, 0, false, false)
            line.set_color(lnRD, color.new(color.gray, 0))
            label.set_color(lbRD, color.new(color.gray, 0))
            label.set_text(lbRD, "$" + str.tostring(roundDn, "#,###"))
        else
            line.set_color(lnRD, color.new(color.gray, 100))
            label.set_text(lbRD, "")
    if vpOn and not na(vpPOC)
        int vpX1 = math.max(0, bar_index - vpLen)
        line.set_xy1(lnPOC, vpX1, vpPOC)
        line.set_xy2(lnPOC, bar_index, vpPOC)
        label.set_xy(lbPOC, bar_index, vpPOC)
        label.set_text(lbPOC, "POC $" + str.tostring(vpPOC, "#,###"))
        line.set_xy1(lnVAH, vpX1, vpVAH)
        line.set_xy2(lnVAH, bar_index, vpVAH)
        label.set_xy(lbVAH, bar_index, vpVAH)
        label.set_text(lbVAH, "VAH $" + str.tostring(vpVAH, "#,###"))
        line.set_xy1(lnVAL, vpX1, vpVAL)
        line.set_xy2(lnVAL, bar_index, vpVAL)
        label.set_xy(lbVAL, bar_index, vpVAL)
        label.set_text(lbVAL, "VAL $" + str.tostring(vpVAL, "#,###"))
    else
        line.set_color(lnPOC, color.new(#ff9800, 100))
        line.set_color(lnVAH, color.new(#ff9800, 100))
        line.set_color(lnVAL, color.new(#ff9800, 100))
        label.set_text(lbPOC, "")
        label.set_text(lbVAH, "")
        label.set_text(lbVAL, "")
    // Стрелка тренда — над самым верхним уровнем: зелёная ▲ вверх,
    // красная ▼ вниз, серая ◆ во флэте + сила тренда.
    string arrowTxt = uptrend ? "▲ ВВЕРХ\nСила " + str.tostring(trendScore) + "/10" : downtrend ? "▼ ВНИЗ\nСила " + str.tostring(trendScore) + "/10" : "◆ ФЛЭТ\nСила " + str.tostring(trendScore) + "/10"
    color arrowCol = uptrend ? color.new(color.green, 0) : downtrend ? color.new(color.red, 0) : color.new(color.gray, 0)
    label.set_xy(lbTrendArrow, bar_index, arrowY)
    label.set_style(lbTrendArrow, label.style_label_down)
    label.set_text(lbTrendArrow, arrowTxt)
    label.set_textcolor(lbTrendArrow, arrowCol)

// ---------- Панель состояния ----------
var table dash = table.new(position.top_right, 2, 12, border_width=1)
if showDash and barstate.islast
    trendTxt = uptrend ? "ВВЕРХ" : downtrend ? "ВНИЗ" : "ФЛЭТ"
    trendBg = uptrend ? color.new(color.green, 0) : downtrend ? color.new(color.red, 0) : color.new(color.gray, 0)
    hdr = color.new(#333333, 0)
    table.cell(dash, 0, 0, "Тренд", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 0, trendTxt, text_color=color.white, bgcolor=trendBg)
    table.cell(dash, 0, 1, "ADX(14)", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 1, str.tostring(adx, "#.#") + (adx > 25 ? " сильный" : adx < 20 ? " слабый" : ""), text_color=color.white, bgcolor=hdr)
    table.cell(dash, 0, 2, "+DI / -DI", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 2, str.tostring(plusDI, "#.#") + " / " + str.tostring(minusDI, "#.#"), text_color=color.white, bgcolor=hdr)
    table.cell(dash, 0, 3, "Сила тренда", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 3, str.tostring(trendScore) + "/10 · " + trendWord, text_color=color.white, bgcolor=trendBg)
    table.cell(dash, 0, 4, "Ближайшее R", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 4, r1 < 1e11 ? "$" + str.tostring(r1, "#,###") + " (+" + str.tostring((r1 - close) / close * 100, "#.#") + "%) · " + str.tostring(rc1) + " " + touchWord(rc1) + " · " + str.tostring(rs1) + "/10" : "—", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 0, 5, "Ближайшая S", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 5, s1 > 0 ? "$" + str.tostring(s1, "#,###") + " (" + str.tostring((s1 - close) / close * 100, "#.#") + "%) · " + str.tostring(sc1) + " " + touchWord(sc1) + " · " + str.tostring(ss1) + "/10" : "—", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 0, 6, "Цена до EMA50", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 6, str.tostring((close - ema50) / ema50 * 100, "#.##") + "%", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 0, 7, "POC", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 7, not na(vpPOC) ? "$" + str.tostring(vpPOC, "#,###") : "—", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 0, 8, "VAH", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 8, not na(vpVAH) ? "$" + str.tostring(vpVAH, "#,###") : "—", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 0, 9, "VAL", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 9, not na(vpVAL) ? "$" + str.tostring(vpVAL, "#,###") : "—", text_color=color.white, bgcolor=hdr)
    color magBg = magDir == "▼" ? color.new(color.red, 0) : magDir == "▲" ? color.new(color.green, 0) : color.new(color.gray, 0)
    table.cell(dash, 0, 10, "Магнит", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 10, not na(magPrice) ? "🧲 " + magDir + " $" + str.tostring(magPrice, "#,###") + " (" + str.tostring((magPrice - close) / close * 100, "#.#") + "%) · " + str.tostring(magScore) + "/10" : "—", text_color=color.white, bgcolor=magBg)
    string dnPart = not na(dnMag) ? "▼ $" + str.tostring(dnMag, "#,###") + " " + str.tostring(dnPct) + "%" : "▼ —"
    string upPart = not na(upMag) ? "▲ $" + str.tostring(upMag, "#,###") + " " + str.tostring(upPct) + "%" : "▲ —"
    table.cell(dash, 0, 11, "Тяга", text_color=color.white, bgcolor=hdr)
    table.cell(dash, 1, 11, pullTot > 0 ? dnPart + " / " + upPart : "—", text_color=color.white, bgcolor=hdr)

// ---------- Алерты ----------
// Касание ближайшего уровня (в пределах 0.5%): цена подошла к развороту.
nearR = r1 < 1e11 and math.abs(close - r1) / r1 < 0.005
nearS = s1 > 0 and math.abs(close - s1) / s1 < 0.005
alertcondition(nearR, title="У сопротивления", message="Тренд+Уровни: цена у сопротивления {{close}}, {{ticker}}")
alertcondition(nearS, title="У поддержки", message="Тренд+Уровни: цена у поддержки {{close}}, {{ticker}}")
alertcondition(ta.crossover(adx, 30), title="ADX выше 30", message="Тренд+Уровни: ADX пересёк 30 вверх, {{ticker}}")
// Появление очень сильного тренда: один раз, когда оценка тренда
// только поднялась до порога из настроек, а не на каждой свече подряд.
bool strongUpNow   = uptrend and trendScore >= alertMinScore
bool strongDownNow = downtrend and trendScore >= alertMinScore
bool newStrongUp   = strongUpNow and not strongUpNow[1]
bool newStrongDown = strongDownNow and not strongDownNow[1]
alertcondition(newStrongUp, title="Очень сильный тренд ВВЕРХ", message="Тренд+Уровни: появился очень сильный тренд ВВЕРХ на {{ticker}} ({{interval}}), цена {{close}}")
alertcondition(newStrongDown, title="Очень сильный тренд ВНИЗ", message="Тренд+Уровни: появился очень сильный тренд ВНИЗ на {{ticker}} ({{interval}}), цена {{close}}")
